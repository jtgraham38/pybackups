[Unit]
Description=pybackups
After=network-online.target
Requires=network-online.target

[Service]
ExecStart=/usr/bin/python3 /opt/pybackups/src/main.py
Restart=always
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1
Environment=STATE_DIRECTORY=/var/lib/pybackups
Environment=CONFIGURATION_DIRECTORY=/etc/pybackups

[Install]
WantedBy=multi-user.target