[Unit]
Description=pybackups - python-powered backup manager by jtgraham38
After=network-online.target
Requires=network-online.target

[Service]
ExecStart=/usr/bin/python3 /opt/pybackups/src/main.py
Restart=always
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1
Environment=STATE_DIRECTORY=/var/lib/pybackups
Environment=CONFIGURATION_DIRECTORY=/etc/pybackups
Nice=19
IOSchedulingClass=idle
IOWeight=10
IOReadBandwidthMax=/dev/sda 20M
MemoryHigh=512M
CPUSchedulingPolicy=idle
CPUQuota=25%
CPUWeight=20

[Install]
WantedBy=multi-user.target