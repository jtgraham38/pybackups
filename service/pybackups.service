[Unit]
Description=pybackups - python-powered backup manager by jtgraham38
After=network-online.target
Requires=network-online.target

[Service]
ExecStart=/usr/bin/python3 /opt/pybackups/src/main.py
Restart=always
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1
Environment=STATE_DIRECTORY=/var/lib/pybackups
Environment=CONFIGURATION_DIRECTORY=/etc/pybackups
#lowest cpu scheduling priority
Nice=19
#only let this process run when other processes don't need the cpu
CPUWeight=idle
#only use io when other processes don't need them
IOWeight=idle
# aggressively reclaim memory above this point
MemoryHigh=512Mb

[Install]
WantedBy=multi-user.target